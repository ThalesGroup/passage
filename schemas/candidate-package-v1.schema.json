{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PASSAGE sealed candidate package v1",
  "description": "Structural schema for the exact manifest fields consumed by load_candidate_package. source.json is an unhashed descriptor and becomes conforming only after candidate freeze. File hashes, path confinement, symlinks, distinct artifact paths and image.recipe membership require the Python loader; ordinary JSON parsing must reject duplicate keys and nonfinite values.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "candidate_id",
    "version",
    "family",
    "entrypoint",
    "kwargs",
    "python",
    "backends",
    "seed",
    "dataset",
    "budget",
    "precision",
    "license",
    "training",
    "image",
    "artifacts"
  ],
  "properties": {
    "schema": {
      "const": "passage-candidate-package/v1"
    },
    "candidate_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]{0,95}(?![\\s\\S])"
    },
    "version": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]{0,95}(?![\\s\\S])"
    },
    "family": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]{0,95}(?![\\s\\S])"
    },
    "entrypoint": {
      "type": "string",
      "pattern": "^[A-Za-z_]\\w*(?:\\.[A-Za-z_]\\w*)*:[A-Za-z_]\\w*(?![\\s\\S])"
    },
    "kwargs": {
      "type": "object",
      "description": "Algorithm parameters. JSON values must be finite; never embed reference labels or host credentials."
    },
    "python": {
      "enum": [
        "3.11",
        "3.12",
        "3.13",
        "3.14"
      ]
    },
    "backends": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "cpu",
          "cuda",
          "openvino",
          "tensorrt"
        ]
      }
    },
    "seed": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "revision",
        "config",
        "cost_model",
        "cost_weight"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}(?![\\s\\S])"
        },
        "config": {
          "type": "string",
          "pattern": "^[1-9]\\d*x[1-9]\\d*(?![\\s\\S])"
        },
        "cost_model": {
          "enum": [
            "absolute_elevation",
            "slope_uphill",
            "slope",
            "elevation",
            "distance",
            "energy"
          ]
        },
        "cost_weight": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "wall_time_ms": {
          "anyOf": [
            {
              "type": "number",
              "exclusiveMinimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "max_expansions": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "max_queue_operations": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "max_live_states": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "precision": {
      "type": "string",
      "pattern": "\\S"
    },
    "license": {
      "type": "string",
      "pattern": "\\S"
    },
    "training": {
      "type": "object",
      "required": [
        "split",
        "test_usage"
      ],
      "properties": {
        "split": {
          "enum": [
            "train",
            "none"
          ]
        },
        "test_usage": {
          "not": {
            "enum": [
              null,
              false,
              0,
              "",
              [],
              {}
            ]
          },
          "description": "Must be truthy, matching the loader. A descriptive string recording prior TEST use is recommended."
        }
      },
      "additionalProperties": true,
      "description": "The loader permits additional provenance fields; it does not authenticate their claims."
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recipe",
        "reference"
      ],
      "properties": {
        "recipe": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?![\\s\\S]*\\\\)(?!(?:[\\s\\S]*/)?\\.\\.?(?:/|$))[\\s\\S]+(?![\\s\\S])",
          "description": "Relative POSIX file path. The loader additionally verifies confinement, file existence and absence of symlinks."
        },
        "reference": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^[^\\s]+@sha256:[0-9a-f]{64}(?![\\s\\S])"
            }
          ]
        }
      },
      "description": "The loader additionally requires recipe to name one declared artifact."
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "role"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?![\\s\\S]*\\\\)(?!(?:[\\s\\S]*/)?\\.\\.?(?:/|$))[\\s\\S]+(?![\\s\\S])",
            "description": "Relative POSIX file path. The loader additionally verifies confinement, file existence and absence of symlinks."
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
          },
          "role": {
            "enum": [
              "code",
              "weights",
              "config",
              "lock",
              "recipe",
              "notice"
            ]
          }
        }
      },
      "allOf": [
        {
          "contains": {
            "type": "object",
            "required": [
              "role"
            ],
            "properties": {
              "role": {
                "const": "code"
              }
            }
          }
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "role"
            ],
            "properties": {
              "role": {
                "const": "lock"
              }
            }
          }
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "role"
            ],
            "properties": {
              "role": {
                "const": "recipe"
              }
            }
          }
        }
      ],
      "description": "The loader checks unique paths, hashes and materialized files. Weights are optional for classical candidates."
    }
  }
}
