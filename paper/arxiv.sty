% arXiv Preprint Style
% A clean, generic style suitable for arXiv submissions and general preprints
% Compatible with any LaTeX distribution, no external dependencies

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{arxiv}[2026/01/27 arXiv preprint style]

% =============================================================================
% OPTIONS
% =============================================================================
\newif\if@preprint\@preprinttrue
\newif\if@final\@finalfalse
\newif\if@nonatbib\@nonatbibfalse
\newif\if@twocolumn\@twocolumnfalse

\DeclareOption{preprint}{\@preprinttrue\@finalfalse}
\DeclareOption{final}{\@finaltrue\@preprintfalse}
\DeclareOption{nonatbib}{\@nonatbibtrue}
\DeclareOption{twocolumn}{\@twocolumntrue}
\ProcessOptions\relax

% =============================================================================
% PAGE GEOMETRY
% =============================================================================
\RequirePackage[
  letterpaper,
  top=1in,
  bottom=1in,
  left=1in,
  right=1in,
  headheight=14pt,
  headsep=20pt,
  footskip=30pt
]{geometry}

% =============================================================================
% FONTS
% =============================================================================
% Use Computer Modern (default LaTeX fonts) - most compatible
% Uncomment the lines below for Times-like fonts if your TeX installation supports them
% \RequirePackage{mathptmx}      % Times for text and math
% \RequirePackage[scaled=0.9]{helvet}  % Helvetica for sans-serif
% \RequirePackage{courier}       % Courier for monospace

% =============================================================================
% LINE SPACING
% =============================================================================
\RequirePackage{setspace}
\if@final
  \setstretch{1.0}
\else
  \setstretch{1.15}  % Slightly more readable for drafts
\fi

% =============================================================================
% HEADERS AND FOOTERS
% =============================================================================
\RequirePackage{fancyhdr}
\pagestyle{fancy}
\fancyhf{}
\fancyhead[L]{\small\textit{Preprint}}
\fancyhead[R]{\small\thepage}
\fancyfoot[C]{}
\renewcommand{\headrulewidth}{0.4pt}
\renewcommand{\footrulewidth}{0pt}

% Plain style for first page
\fancypagestyle{plain}{
  \fancyhf{}
  \fancyfoot[C]{\small\thepage}
  \renewcommand{\headrulewidth}{0pt}
}

% =============================================================================
% TITLE FORMATTING
% =============================================================================
\def\@maketitle{%
  \newpage
  \null
  \vskip 1.5em%
  \begin{center}%
    {\LARGE\bfseries \@title \par}%
    \vskip 1.5em%
    {\large
      \lineskip 0.5em%
      \begin{tabular}[t]{c}%
        \@author
      \end{tabular}\par}%
    \vskip 1em%
    {\small \@date}%
  \end{center}%
  \par
  \vskip 1.5em
}

% =============================================================================
% ABSTRACT
% =============================================================================
\renewenvironment{abstract}{%
  \begin{center}
    \textbf{\large Abstract}
  \end{center}
  \begin{quotation}
  \small\noindent
}{%
  \end{quotation}
  \vskip 1em
}

% =============================================================================
% SECTION FORMATTING
% =============================================================================
\RequirePackage{titlesec}
\titleformat{\section}{\large\bfseries}{\thesection}{1em}{}
\titleformat{\subsection}{\normalsize\bfseries}{\thesubsection}{1em}{}
\titleformat{\subsubsection}{\normalsize\itshape}{\thesubsubsection}{1em}{}

\titlespacing*{\section}{0pt}{2ex plus 1ex minus 0.5ex}{1ex plus 0.5ex}
\titlespacing*{\subsection}{0pt}{1.5ex plus 0.5ex minus 0.3ex}{0.8ex plus 0.3ex}
\titlespacing*{\subsubsection}{0pt}{1ex plus 0.3ex minus 0.2ex}{0.5ex plus 0.2ex}

% =============================================================================
% CAPTIONS
% =============================================================================
\RequirePackage[small,bf,labelsep=period]{caption}
\setlength{\captionmargin}{10pt}

% =============================================================================
% BIBLIOGRAPHY
% =============================================================================
\if@nonatbib\else
  \RequirePackage{natbib}
  \bibliographystyle{plainnat}
  \setcitestyle{authoryear,round,citesep={;},aysep={,},yysep={;}}
\fi

% =============================================================================
% THEOREM ENVIRONMENTS
% =============================================================================
\RequirePackage{amsthm}
\theoremstyle{plain}
\newtheorem{theorem}{Theorem}[section]
\newtheorem{lemma}[theorem]{Lemma}
\newtheorem{proposition}[theorem]{Proposition}
\newtheorem{corollary}[theorem]{Corollary}

\theoremstyle{definition}
\newtheorem{definition}[theorem]{Definition}
\newtheorem{example}[theorem]{Example}

\theoremstyle{remark}
\newtheorem{remark}[theorem]{Remark}

% =============================================================================
% HYPERLINKS
% =============================================================================
\RequirePackage{hyperref}
\hypersetup{
  colorlinks=true,
  linkcolor=blue!70!black,
  citecolor=green!50!black,
  urlcolor=blue!80!black,
  pdfborder={0 0 0},
}

% =============================================================================
% AUTHOR AFFILIATIONS (simple approach)
% =============================================================================
\newcommand{\And}{\end{tabular}\hfill\begin{tabular}[t]{c}}
\newcommand{\AND}{\end{tabular}\par\vskip 0.5em\begin{tabular}[t]{c}}

% Email command
\newcommand{\email}[1]{\texttt{#1}}

% Affiliation footnote style
\newcommand{\affmark}[1]{\textsuperscript{#1}}
\newcommand{\affaddr}[1]{\small\textit{#1}}

% =============================================================================
% KEYWORDS
% =============================================================================
\newcommand{\keywords}[1]{%
  \vskip 0.5em
  \noindent\textbf{Keywords:} #1
  \vskip 1em
}

% =============================================================================
% ACKNOWLEDGMENTS
% =============================================================================
\newenvironment{acknowledgments}{%
  \section*{Acknowledgments}
}{%
  \par
}

% Alias
\newenvironment{acknowledgements}{%
  \begin{acknowledgments}
}{%
  \end{acknowledgments}
}

% =============================================================================
% USEFUL SHORTCUTS
% =============================================================================
\newcommand{\ie}{\textit{i.e.}}
\newcommand{\eg}{\textit{e.g.}}
\newcommand{\cf}{\textit{cf.}}
\newcommand{\etal}{\textit{et al.}}
\newcommand{\wrt}{w.r.t.}

\endinput
